#!/bin/bash
set -euo pipefail

# Configuration
IMAGE="${LEGIT_IMAGE:-ghcr.io/sheurich/legit-apple-swival:latest}"
SSH_PORT="${LEGIT_SSH_PORT:-2222}"
LEGIT_HOME="${LEGIT_HOME:-${HOME}/.legit}"
HOST_KEYS_DIR="${LEGIT_HOME}/host_keys"
AUTH_KEYS="${LEGIT_AUTHORIZED_KEYS:-${HOME}/.ssh/authorized_keys}"
CONTAINER_NAME="legit-server-${SSH_PORT}"

# Swival provider keys (pass whichever is set in the environment)
SWIVAL_ENV_ARGS=()
[[ -n "${GEMINI_API_KEY:-}" ]]    && SWIVAL_ENV_ARGS+=(-e "GEMINI_API_KEY=${GEMINI_API_KEY}")
[[ -n "${ANTHROPIC_API_KEY:-}" ]] && SWIVAL_ENV_ARGS+=(-e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}")
[[ -n "${OPENAI_API_KEY:-}" ]]    && SWIVAL_ENV_ARGS+=(-e "OPENAI_API_KEY=${OPENAI_API_KEY}")

# Parse arguments
INTERACTIVE=false
while [[ $# -gt 0 ]]; do
    case $1 in
        --interactive)
            INTERACTIVE=true
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: $0 [--interactive]" >&2
            exit 1
            ;;
    esac
done

# Validation
if [[ ! -f "$AUTH_KEYS" ]]; then
    echo "Error: $AUTH_KEYS not found" >&2
    exit 1
fi

if ! command -v container &>/dev/null; then
    echo "Error: Apple container CLI not installed (brew install container)" >&2
    exit 1
fi

# Parse LEGIT_MOUNT_DIRS and optional args
EXTRA_ARGS=()
if [ -n "${LEGIT_MOUNT_DIRS:-}" ]; then
    IFS=':' read -ra DIRS <<< "$LEGIT_MOUNT_DIRS"
    for dir in "${DIRS[@]}"; do
        if [ -d "$dir" ]; then
            basename=$(basename "$dir")
            EXTRA_ARGS+=("-v" "${dir}:/home/git/${basename}")
        else
            echo "Warning: $dir does not exist, skipping mount" >&2
        fi
    done
fi

# Mount host swival config (profiles, memory) if present
SWIVAL_CONFIG="${HOME}/.config/swival"
[[ -d "$SWIVAL_CONFIG" ]] && EXTRA_ARGS+=("-v" "${SWIVAL_CONFIG}:/home/git/.config/swival:ro")

# Create required directories
mkdir -p "$HOST_KEYS_DIR"

# Set run mode: interactive (-it) or detached (-d)
RUN_MODE=$([[ "$INTERACTIVE" == "true" ]] && echo "-it" || echo "-d")

# Run container
container run --rm "$RUN_MODE" \
    --name "$CONTAINER_NAME" \
    -p "${SSH_PORT}:22" \
    -e GIT_USER_UID="$(id -u)" \
    -e GIT_USER_GID="$(id -g)" \
    "${SWIVAL_ENV_ARGS[@]+"${SWIVAL_ENV_ARGS[@]}"}" \
    -v "${AUTH_KEYS}:/root/git_authorized_keys:ro" \
    -v "${HOST_KEYS_DIR}:/etc/ssh/ssh_host_keys" \
    "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}" \
    "$IMAGE"
