#!/usr/bin/env bash

# legit-apple-swival post-receive hook
#
# Drop this file in the root of any repo you push to the legit server.
# It must be executable: chmod +x .legit_post_receive
#
# When you push a branch, swival (with --self-review) inspects the code,
# commits fixes, and pushes an agent branch back to the legit remote.
# Fetch it with: git fetch legit && git log legit/swival/<branch>/<timestamp>
#
# The push blocks until swival finishes, so you see its output live.

set -euo pipefail

old_rev=$1
new_rev=$2

echo "swival: improving ${old_rev:0:7}..${new_rev:0:7}"

git config user.email "swival@legit.local"
git config user.name "Swival"

pushed_branch=$(git rev-parse --abbrev-ref HEAD)
agent_branch="swival/${pushed_branch}/$(date +%Y%m%dT%H%M%S)"
git switch -c "$agent_branch"

swival \
  --yolo \
  --self-review \
  --max-review-rounds 3 \
  --no-instructions \
  --no-skills \
  "Inspect the codebase for TODO/FIXME comments, obvious correctness issues, and
clarity problems. Fix each one with a focused, atomic commit. Commit subject lines:
imperative mood, ≤72 chars. Do not add dependencies. Do not make speculative
refactors. When done, verify the working tree is clean."

git push origin "$agent_branch"

echo ""
echo "Agent branch: $agent_branch"
echo "Fetch with:   git fetch legit && git checkout swival/${pushed_branch}/..."
